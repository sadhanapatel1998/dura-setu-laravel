APP_NAME=DuraSetu
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=durasetu
DB_USERNAME=root
DB_PASSWORD=

# Sessions/cache on files so no extra tables are needed
SESSION_DRIVER=file
SESSION_LIFETIME=240
CACHE_STORE=file
QUEUE_CONNECTION=sync

# SMTP is managed from Admin > Settings > Mail (these are only fallbacks)
MAIL_MAILER=log
